+void ControllerScriptEngineBase::registerPlayerManager(
+        std::shared_ptr<PlayerManager> pPlayerManager) {
+    s_pPlayerManager = std::move(pPlayerManager);
+}
+
+bool ControllerScriptEngineBase::loadTrackToPlayer(
+        const QString& group, const QString& path) {
+    VERIFY_OR_DEBUG_ASSERT(s_pPlayerManager != nullptr) {
+        qCritical() << "loadTrackToPlayer: PlayerManager not initialised";
+        return false;
+    }
+    if (path.isEmpty()) {
+        qWarning() << "loadTrackToPlayer: empty path";
+        return false;
+    }
+    const QFileInfo fileInfo(path);
+    if (!fileInfo.exists() || !fileInfo.isFile()) {
+        qWarning() << "loadTrackToPlayer: file not found:" << path;
+        return false;
+    }
+    // Use Mixxx's existing non-playing load path. The PlayerManager forwards
+    // this to the normal library/player loading pipeline.
+    s_pPlayerManager->slotLoadLocationToPlayer(
+            fileInfo.absoluteFilePath(), group, /*play=*/false);
+    return true;
+}
